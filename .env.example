# Copiar a .env.local y completar.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taller_web

# Cadena larga y aleatoria; sin ella el sistema no arranca en producción.
JWT_SECRET=

# Hacienda (factura de sujeto excluido). El usuario de la API y el ambiente se guardan en Configuración > Empresa.
DTE_API_CLAVE=
# Clave privada del certificado (la que se configuró en el firmador).
DTE_CERT_CLAVE=
# Firmador oficial de Hacienda corriendo en local.
DTE_FIRMADOR_URL=http://localhost:8113/firmardocumento/
